<?xml version="1.0" encoding="utf-8"?>
<!-- Emergency numbers list for Greece -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D18585"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp"
            android:text="@string/emergency_title"
            android:textAlignment="center"
            android:textColor="#330606"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 112: General Emergency -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="112"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/emergency_112_desc"
            android:textColor="#0B0000"
            android:textSize="16sp" />

        <!-- 100: Police -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/emergency_100_desc"
            android:textColor="#0D0000"
            android:textSize="16sp" />

        <!-- 166: Ambulance -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="166"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/emergency_166_desc"
            android:textColor="#0F0000"
            android:textSize="16sp" />

        <!-- 199: Fire -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="199"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/emergency_199_desc"
            android:textColor="#0F0000"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="108"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/emergency_108_desc"
            android:textColor="#0D0000"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="171"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/emergency_171_desc"
            android:textColor="#140000"
            android:textSize="16sp" />

        <TextView
            android:layout_width="223dp"
            android:layout_height="58dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bubble_right"
            android:backgroundTint="#EBCCCC"
            android:padding="12dp"
            android:text="@string/emergency_bubble_text"
            android:textColor="#9E0F0F"
            android:textSize="23sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgNewPhoto"
            android:layout_width="355dp"
            android:layout_height="469dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/persona_asustada" />

    </LinearLayout>
</ScrollView>