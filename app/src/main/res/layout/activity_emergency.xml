<?xml version="1.0" encoding="utf-8"?>
<!-- Emergency numbers list for Greece -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Greek Emergency Numbers"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="24dp"
            android:textAlignment="center" />

        <!-- 112: General Emergency -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="112"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_red_dark" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="European Emergency Number (General emergency)"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <!-- 100: Police -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hellenic Police"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <!-- 166: Ambulance -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="166"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medical Emergencies / Ambulance"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <!-- 199: Fire -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="199"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fire Department"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="108"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hellenic Coast Guard"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="171"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tourist Police (Assistance for visitors)"
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="223dp"
            android:layout_height="58dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bubble_right"
            android:padding="12dp"
            android:text="What do I do!?"
            android:textColor="#9E0F0F"
            android:textSize="23sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgNewPhoto"
            android:layout_width="355dp"
            android:layout_height="469dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/persona_asustada" />

    </LinearLayout>
</ScrollView>