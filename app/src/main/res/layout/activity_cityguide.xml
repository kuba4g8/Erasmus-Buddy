<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6D5FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvCityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:text="@string/city_guide_title"
                android:textColor="#4E356D"
                android:textSize="27sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCity"
                android:layout_width="match_parent"
                android:layout_height="231dp"
                android:layout_marginBottom="24dp"
                android:scaleType="centerCrop"
                android:src="@drawable/thessaloniki" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/city_guide_prepared"
                android:textAlignment="center"
                android:textColor="#0F0000"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="@string/city_guide_know_basics"
                android:textAlignment="center"
                android:textColor="#871313"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/vocabularyBubbles"
                android:layout_width="match_parent"
                android:layout_height="602dp"
                android:layout_marginBottom="35dp"
                android:background="#78CAE2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVocabulary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/city_guide_vocabulary"
                    android:textAlignment="center"
                    android:textColor="#4E356D"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_left"
                    android:backgroundTint="@color/white"
                    android:padding="12dp"
                    android:text="@string/city_guide_hello"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_right"
                    android:padding="12dp"
                    android:text="@string/city_guide_thank_you"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_left"
                    android:padding="12dp"
                    android:text="@string/city_guide_good_morning"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_right"
                    android:padding="12dp"
                    android:text="@string/city_guide_cheers"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_left"
                    android:padding="12dp"
                    android:text="@string/city_guide_nice_to_meet"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_right"
                    android:padding="12dp"
                    android:text="@string/city_guide_good_evening"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_left"
                    android:backgroundTint="@color/white"
                    android:padding="12dp"
                    android:text="@string/city_guide_coffee_milk"
                    android:textColor="#333333"
                    android:textSize="16sp" />

            </LinearLayout>


            <TextView
                android:id="@+id/tvBestSpots"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginBottom="12dp"
                android:text="@string/city_guide_best_spots"
                android:textColor="#4E356D"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/city_guide_plan1"
                android:textColor="#333333"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="292dp"
                android:layout_height="278dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:soundEffectsEnabled="true"
                app:srcCompat="@drawable/paraguas_thess"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:text="@string/city_guide_plan2"
                android:textColor="#333333"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="323dp"
                android:layout_height="209dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/sunset_anopolis"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="69dp"
                android:text="@string/city_guide_plan3"
                android:textColor="#333333"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/city_guide_rotunda_location"
                android:textColor="#412657"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMap"
                android:layout_width="wrap_content"
                android:layout_height="43dp"
                android:layout_marginBottom="30dp"
                android:backgroundTint="#7E57C2"
                android:text="@string/city_guide_btn_map"
                android:textColor="@android:color/white"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:text="@string/city_guide_plan4"
                android:textColor="#333333"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="216dp"
                android:layout_height="114dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/bougatsa"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/textView8"
                android:layout_width="match_parent"
                android:layout_height="37dp"
                android:text="@string/city_guide_plan5"
                android:textColor="#333333"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/imageView8"
                android:layout_width="233dp"
                android:layout_height="144dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                app:srcCompat="@drawable/halkidiki"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:id="@+id/textView9"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:text="@string/city_guide_plan6"
                android:textColor="#333333"
                android:textSize="17sp" />
            <TextView
                android:id="@+id/textView10"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:text="@string/city_guide_plan7"
                android:textColor="#333333"
                android:textSize="17sp" />
            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="263dp"
                android:layout_height="129dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                app:srcCompat="@drawable/karidi_beach"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/textView12"
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:text="@string/city_guide_footer"
                android:textColor="#3F51B5"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>