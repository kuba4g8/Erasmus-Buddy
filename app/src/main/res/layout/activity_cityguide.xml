<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6D5FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvCityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:text="CITY GUIDE THESSALONIKI"
                android:textColor="#4E356D"
                android:textSize="27sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCity"
                android:layout_width="match_parent"
                android:layout_height="231dp"
                android:layout_marginBottom="24dp"
                android:scaleType="centerCrop"
                android:src="@drawable/thessaloniki" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Are you prepared to live in thessaloniki?"
                android:textAlignment="center"
                android:textColor="#0F0000"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="Lets see if you know all these basic things..."
                android:textAlignment="center"
                android:textColor="#871313"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/vocabularyBubbles"
                android:layout_width="match_parent"
                android:layout_height="602dp"
                android:layout_marginBottom="35dp"
                android:background="#78CAE2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVocabulary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Basic Greek Vocabulary"
                    android:textAlignment="center"
                    android:textColor="#4E356D"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_left"
                    android:backgroundTint="@color/white"
                    android:padding="12dp"
                    android:text="Hello &#10;Γεια σου (Yia sou)"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_right"
                    android:padding="12dp"
                    android:text="Thank you &#10;Ευχαριστώ (Efharistó)"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_left"
                    android:padding="12dp"
                    android:text="Good morning &#10;Καλημέρα (Kaliméra)"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_right"
                    android:padding="12dp"
                    android:text="Cheers &#10;Γεια μας (Yia mas)"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_left"
                    android:padding="12dp"
                    android:text="Nice to meet you &#10;Χάρηκα (Hárika)"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_right"
                    android:padding="12dp"
                    android:text="Good evening &#10;Καλησπέρα (Kalispéra)"
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bubble_left"
                    android:backgroundTint="@color/white"
                    android:padding="12dp"
                    android:text="I would like a coffee with milk, please. &#10;Θα ήθελα έναν καφέ με γάλα, παρακαλώ &#10;(Tha íthela énan kafé me gála, parakaló)"
                    android:textColor="#333333"
                    android:textSize="16sp" />

            </LinearLayout>


            <TextView
                android:id="@+id/tvBestSpots"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginBottom="12dp"
                android:text="Best Spots and Plans "
                android:textColor="#4E356D"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="1. Walk along the port to see the WHITE TOWER and then UMBRELLAS sculpture"
                android:textColor="#333333"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="292dp"
                android:layout_height="278dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:soundEffectsEnabled="true"
                app:srcCompat="@drawable/paraguas_thess"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:text="2. Go up to Ano Poli for SUNSET and VIEW of the city (ACROPOLIS WALLS)"
                android:textColor="#333333"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="323dp"
                android:layout_height="209dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/sunset_anopolis"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="69dp"
                android:text="3. Take a beer with your friends in the BARS near ROTUNDA. Some of them even have DISCOUNT if you are Erasmus student: "
                android:textColor="#333333"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rotunda location (next to Arc of Galerio): "
                android:textColor="#412657"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMap"
                android:layout_width="wrap_content"
                android:layout_height="43dp"
                android:layout_marginBottom="30dp"
                android:backgroundTint="#7E57C2"
                android:text="open map"
                android:textColor="@android:color/white"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:text="4. Try BOUGATSA for breakfast"
                android:textColor="#333333"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="216dp"
                android:layout_height="114dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/bougatsa"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/textView8"
                android:layout_width="match_parent"
                android:layout_height="37dp"
                android:text="5. Rent a car and explore HALKIDIKI BEACHES"
                android:textColor="#333333"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/imageView8"
                android:layout_width="233dp"
                android:layout_height="144dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                app:srcCompat="@drawable/halkidiki"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:id="@+id/textView9"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:text="6. Visit ROTUNDA and ARCH OF GALERIUS (free entrance for students below 25 )"
                android:textColor="#333333"
                android:textSize="17sp" />
            <TextView
                android:id="@+id/textView10"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:text="7. Spend a day in KARYDI BEACH "
                android:textColor="#333333"
                android:textSize="17sp" />
            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="263dp"
                android:layout_height="129dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                app:srcCompat="@drawable/karidi_beach"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/textView12"
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:text="GREECE HAS SO MANY GOOD PLANS WAITING FOR YOU !!!"
                android:textColor="#3F51B5"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>