<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/challenges"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FD"
    android:scaleX="1"
    tools:context=".ChallengesFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6D5FF">

        <LinearLayout
            android:id="@+id/challengesRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvChallengesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Erasmus Challenges"
                android:textAlignment="center"
                android:textColor="#4E356D"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChallengesSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Complete small missions abroad and become a local legend."
                android:textAlignment="center"
                android:textColor="#7A5C91"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:background="@color/white"
                android:scaleType="centerCrop"
                android:src="@drawable/representation_challenges" />

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="#EFDB02"
                android:scaleX="1.3"
                android:src="@drawable/challenge" />

            <TextView
                android:id="@+id/tvAddTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Add your own task"
                android:textColor="#4E356D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Example: Buy coffee in local language"
                android:inputType="text"
                android:textColor="#1E0E33" />

            <Button
                android:id="@+id/btnAddTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#7E57C2"
                android:text="ADD TASK"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvDefaultTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Survival tasks"
                android:textColor="#4E356D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbCoffee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buy coffee in the local language"
                android:textColor="@color/material_dynamic_tertiary20" />

            <CheckBox
                android:id="@+id/cbSupermarket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find the cheapest supermarket"
                android:textColor="#3A284E" />
            <CheckBox
                android:id="@+id/cbCultural"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Make excursion with ESN organization"
                android:textColor="#3A284E" />
            <CheckBox
                android:id="@+id/cbTransport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use public transport without getting lost"
                android:textColor="#3A284E" />

            <CheckBox
                android:id="@+id/cbCulture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Visit 3 cultural spots"
                android:textColor="#3A284E" />

            <CheckBox
                android:id="@+id/cbFriend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Make one local friend"
                android:textColor="#3A284E" />

            <CheckBox
                android:id="@+id/cbHospital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find the nearest hospital"
                android:textColor="#3A284E" />

            <LinearLayout
                android:id="@+id/layoutTaskButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAddTaskBottom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@android:color/system_error_light"
                    android:text="DELETE task"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btnMarkDone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/design_default_color_secondary_variant"
                    android:text="task DONE"
                    android:textColor="@android:color/white" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>