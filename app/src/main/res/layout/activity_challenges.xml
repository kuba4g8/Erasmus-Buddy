<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/challenges"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FD"
    android:scaleX="1"
    tools:context=".ChallengesFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6D5FF">

        <LinearLayout
            android:id="@+id/challengesRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvChallengesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Erasmus Challenges"
                android:textAlignment="center"
                android:textColor="#4E356D"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChallengesSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Complete small missions abroad and become a local legend."
                android:textAlignment="center"
                android:textColor="#7A5C91"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:background="@color/white"
                android:scaleType="centerCrop"
                android:src="@drawable/representation_challenges" />

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="#EFDB02"
                android:scaleX="1.3"
                android:src="@drawable/challenge" />

            <TextView
                android:id="@+id/tvAddTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Add your own task"
                android:textColor="#4E356D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Example: Buy coffee in local language"
                android:inputType="text"
                android:textColor="#291840" />

            <Button
                android:id="@+id/btnAddTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#7E57C2"
                android:text="ADD TASK"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvDefaultTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Survival tasks"
                android:textColor="#4E356D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- This container holds all of our challenges, they will be added and deleted by "ChallengesFragment.java" -->
            <LinearLayout
                android:id="@+id/containerTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>